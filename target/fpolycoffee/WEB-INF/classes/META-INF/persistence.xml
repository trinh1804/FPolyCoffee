<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd" version="3.0">

    <persistence-unit name="FPolyCoffee" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Các Entity class -->
        <class>com.entity.Role</class>
        <class>com.entity.User</class>
        <class>com.entity.Customer</class>
        <class>com.entity.Category</class>
        <class>com.entity.Drink</class>
        <class>com.entity.DiscountCode</class>
        <class>com.entity.Bill</class>
        <class>com.entity.BillDetail</class>
        <class>com.entity.PointTransaction</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- SQL Server JDBC -->
            <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlserver://localhost:1433;databaseName=FPOLYCOFFEE;encrypt=false;trustServerCertificate=true"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value="Trinh123"/>

            <!-- Hibernate dialect -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect"/>

            <!-- DDL: validate = kiểm tra schema khớp với entity, không tự tạo bảng -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Hiển thị SQL khi develop (tắt ở production) -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Connection pool cơ bản (Hibernate built-in) -->
            <property name="hibernate.connection.pool_size" value="10"/>

            <!-- Encoding -->
            <property name="hibernate.connection.charSet" value="UTF-8"/>
        </properties>
    </persistence-unit>

</persistence>